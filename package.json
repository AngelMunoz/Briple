{
  "name": "briple",
  "version": "1.0.0",
  "description": "Sample Fable.Ripple app",
  "scripts": {
    "postinstall": "dotnet tool restore",
    "start": "dotnet fable watch src --run pnpm exec vite",
    "build": "dotnet fable src && vite build",
    "preview": "vite preview",
    "assets": "pwa-assets-generator && pwa-assets-generator -c pwa-assets.light.config.ts",
    "test:browser": "dotnet fable tests/Briple.Tests.fsproj --noCache --sourceMaps && node tests/browser.mjs",
    "test:e2e": "dotnet fable src && node tests/e2e.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "devDependencies": {
    "@vite-pwa/assets-generator": "2.0.0",
    "playwright": "1.56.0",
    "qunit": "2.26.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "@angelmunoz/metrino": "0.5.2",
    "@mdi/js": "7.4.47",
    "lit": "3.3.3"
  }
}
