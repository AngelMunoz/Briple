{
  "name": "briple",
  "version": "0.0.1",
  "description": "Sample Fable.Ripple app",
  "scripts": {
    "postinstall": "dotnet tool restore",
    "start": "dotnet fable watch src --run pnpm exec vite",
    "build": "dotnet fable src",
    "test:browser": "dotnet fable tests/Briple.Tests.fsproj --noCache --sourceMaps && node tests/browser.mjs",
    "test:e2e": "dotnet fable src && node tests/e2e.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "devDependencies": {
    "playwright": "^1.56.0",
    "qunit": "^2.26.0",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@angelmunoz/metrino": "0.5.0",
    "@mdi/js": "7.4.47",
    "lit": "3.3.3"
  }
}
